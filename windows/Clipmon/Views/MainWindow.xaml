<Window x:Class="Clipmon.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Clipmon.ViewModels"
        xmlns:models="clr-namespace:Clipmon.Models"
        Title="Clipmon"
        Width="1180" Height="780"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundGradient}"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        AllowDrop="True"
        Drop="OnFilesDropped"
        DragOver="OnDragOver"
        FontFamily="{StaticResource UIFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================== TOP BAR ======================== -->
        <Grid Grid.Row="0" Margin="20,18,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand mark -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="10"
                        Background="{StaticResource AccentGradient}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Opacity="0.30"
                                          ShadowDepth="2" Direction="270"
                                          Color="#3A4FE6" />
                    </Border.Effect>
                    <TextBlock Text="" FontFamily="{StaticResource GlyphFont}"
                               Foreground="White" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Clipmon" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Your clipboard, organized."
                               FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                               Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Status pill -->
            <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                    CornerRadius="999" Padding="12,5" Margin="0,0,12,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SuccessSubtleBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                <Setter Property="Background" Value="{StaticResource WarningSubtleBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="11" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                <Setter Property="Text" Value="Live · watching clipboard" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        <Setter Property="Text" Value="Paused" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Toolbar buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding CaptureNowCommand}"
                        ToolTip="Capture clipboard now (force-grab the current clipboard contents)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="{StaticResource GlyphFont}"
                                   FontSize="14" Margin="0,0,8,1" />
                        <TextBlock Text="Capture now" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolbarButton}" Margin="4,0,0,0"
                        Command="{Binding TogglePauseResumeCommand}"
                        ToolTip="Pause or resume clipboard monitoring">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource GlyphFont}" FontSize="14" Margin="0,0,8,1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                            <Setter Property="Text" Value="" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Pause" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                            <Setter Property="Text" Value="Resume" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource DestructiveButton}" Margin="4,0,0,0"
                        Click="OnClearClicked"
                        ToolTip="Clear clipboard history">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="{StaticResource GlyphFont}"
                                   FontSize="14" Margin="0,0,8,1" />
                        <TextBlock Text="Clear" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ======================== BODY ======================== -->
        <Grid Grid.Row="1" Margin="20,4,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="320" MaxWidth="460" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- =================== SIDEBAR CARD =================== -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Hero card (gradient) -->
                    <Border Grid.Row="0" CornerRadius="14"
                            Background="{StaticResource HeroGradient}"
                            Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource GlyphFont}"
                                           Foreground="{StaticResource AccentDeepBrush}"
                                           FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Clipboard Vault" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{StaticResource AccentDeepBrush}" />
                            </StackPanel>
                            <TextBlock Text="A local clipboard manager backed by SQLite."
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Search -->
                    <Border Grid.Row="1" Margin="0,16,0,0"
                            Background="{StaticResource InsetSurfaceBrush}"
                            CornerRadius="10" Padding="12,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="" FontFamily="{StaticResource GlyphFont}"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="14" VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <Grid Grid.Column="1">
                                <TextBlock Text="Search clipboard history" FontSize="13"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="SearchBox"
                                         Style="{StaticResource SearchTextBox}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                                    Padding="6,3" Margin="6,0,0,0"
                                    Click="OnClearSearchClicked"
                                    Visibility="{Binding SearchText, Converter={StaticResource NotNullToVisibility}}">
                                <TextBlock Text="" FontFamily="{StaticResource GlyphFont}"
                                           FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Scope segmented -->
                    <Border Grid.Row="2" Margin="0,12,0,0"
                            Background="{StaticResource InsetSurfaceBrush}"
                            CornerRadius="10" Padding="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="ScopeAll" Content="All" GroupName="Scope"
                                         Style="{StaticResource ScopePill}"
                                         Click="OnScopeAllClicked" />
                            <RadioButton x:Name="ScopePinned" Grid.Column="1" Content="Pinned" GroupName="Scope"
                                         Style="{StaticResource ScopePill}"
                                         Click="OnScopePinnedClicked" />
                        </Grid>
                    </Border>

                    <!-- Stats row -->
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource StatTile}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" FontFamily="{StaticResource GlyphFont}"
                                               Foreground="{StaticResource AccentBrush}" FontSize="11"
                                               Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Total" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding TotalCount}" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource StatTile}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" FontFamily="{StaticResource GlyphFont}"
                                               Foreground="{StaticResource WarningBrush}" FontSize="11"
                                               Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Pinned" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding PinnedCount}" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource StatTile}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" FontFamily="{StaticResource GlyphFont}"
                                               Foreground="{StaticResource SuccessBrush}" FontSize="11"
                                               Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Visible" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding VisibleCount}" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Drop hint -->
                    <Border Grid.Row="4" Margin="0,14,0,0" Padding="14,10"
                            CornerRadius="12" Background="{StaticResource InsetSurfaceBrush}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="" FontFamily="{StaticResource GlyphFont}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="14" Margin="0,0,10,0" />
                            <StackPanel>
                                <TextBlock Text="Drop files anywhere" FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Images, audio, spreadsheets, docs" FontSize="11"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Entry list -->
                    <Border Grid.Row="5" Margin="0,14,0,0" CornerRadius="12">
                        <ListBox x:Name="EntryList"
                                 Background="Transparent" BorderThickness="0"
                                 ItemsSource="{Binding EntriesView}"
                                 SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Padding="0">
                            <ListBox.Resources>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid>
                                                    <!-- Accent left bar (visible when selected) -->
                                                    <Border x:Name="AccentBar" Width="3"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,8,0,8"
                                                            CornerRadius="2"
                                                            Background="{StaticResource AccentGradient}"
                                                            Visibility="Hidden" />
                                                    <Border x:Name="Bd"
                                                            Background="Transparent"
                                                            CornerRadius="10"
                                                            BorderThickness="0"
                                                            Padding="14,12"
                                                            Margin="6,0,0,0">
                                                        <ContentPresenter />
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedRowBrush}" />
                                                        <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ClipboardEntry}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Type avatar -->
                                        <Border Grid.Column="0" Width="36" Height="36"
                                                CornerRadius="9"
                                                Background="{StaticResource AccentSubtleBrush}"
                                                VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock FontFamily="{StaticResource GlyphFont}"
                                                       Text="{Binding Kind, Converter={StaticResource KindToGlyph}}"
                                                       Foreground="{StaticResource AccentDeepBrush}"
                                                       FontSize="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Kind, Converter={StaticResource KindToDisplayName}}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentDeepBrush}"
                                                           TextOptions.TextFormattingMode="Display" />
                                                <TextBlock Text="·" Margin="6,0" FontSize="10"
                                                           Foreground="{StaticResource TextTertiaryBrush}" />
                                                <TextBlock Text="{Binding CreatedAt, Converter={StaticResource RelativeTime}}"
                                                           FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="13"
                                                       FontWeight="Medium"
                                                       TextWrapping="Wrap" MaxHeight="40"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding SourceApplication}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       Margin="0,4,0,0"
                                                       Visibility="{Binding SourceApplication, Converter={StaticResource NotNullToVisibility}}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   FontFamily="{StaticResource GlyphFont}"
                                                   Text="{Binding IsPinned, Converter={StaticResource PinnedToGlyph}}"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   FontSize="14" Margin="8,2,0,0"
                                                   VerticalAlignment="Top"
                                                   Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy"
                                              Command="{Binding PlacementTarget.DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Pin / Unpin"
                                              Command="{Binding PlacementTarget.DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem Header="Delete"
                                              Command="{Binding PlacementTarget.DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <!-- =================== DETAIL CARD =================== -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <Grid>
                    <!-- Empty state -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                            <Border Width="100" Height="100" CornerRadius="28"
                                    Background="{StaticResource HeroGradient}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="" FontFamily="{StaticResource GlyphFont}"
                                           FontSize="44" Foreground="{StaticResource AccentDeepBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,20,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Your clipboard, but better." />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TotalCount}" Value="0">
                                                <Setter Property="Text" Value="Nothing here yet" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="Copy any text, image, or file and it will appear here automatically. Pick something from the left to see the full preview." />

                            <Border Margin="0,28,0,0" Padding="14,10"
                                    Background="{StaticResource InsetSurfaceBrush}"
                                    CornerRadius="999"
                                    HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" FontFamily="{StaticResource GlyphFont}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Selected entry detail -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"
                                  Padding="28,24,28,24">
                        <StackPanel>
                            <!-- Header section -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="14"
                                        Background="{StaticResource AccentGradient}"
                                        VerticalAlignment="Top" Margin="0,0,16,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" Opacity="0.25"
                                                          ShadowDepth="3" Direction="270"
                                                          Color="#3A4FE6" />
                                    </Border.Effect>
                                    <TextBlock FontFamily="{StaticResource GlyphFont}"
                                               Text="{Binding SelectedEntry.Kind, Converter={StaticResource KindToGlyph}}"
                                               Foreground="White" FontSize="24"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{StaticResource AccentSubtleBrush}"
                                                CornerRadius="999" Padding="9,3">
                                            <TextBlock Text="{Binding SelectedEntry.Kind, Converter={StaticResource KindToDisplayName}}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentDeepBrush}" />
                                        </Border>
                                        <Border Background="{StaticResource WarningSubtleBrush}"
                                                CornerRadius="999" Padding="9,3" Margin="8,0,0,0"
                                                Visibility="{Binding SelectedEntry.IsPinned, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="" FontFamily="{StaticResource GlyphFont}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource WarningBrush}"
                                                           Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Pinned" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource WarningBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedEntry.DisplayTitle}"
                                               FontSize="22" FontWeight="Bold"
                                               TextWrapping="Wrap" Margin="0,8,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Meta chips -->
                            <WrapPanel Margin="0,16,0,0">
                                <Border Style="{StaticResource MetaChip}" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" FontFamily="{StaticResource GlyphFont}"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedEntry.CreatedAt, Converter={StaticResource RelativeTime}}"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource MetaChip}" Margin="0,0,8,8"
                                        Visibility="{Binding SelectedEntry.SourceApplication, Converter={StaticResource NotNullToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" FontFamily="{StaticResource GlyphFont}"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedEntry.SourceApplication}"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource MetaChip}" Margin="0,0,8,8"
                                        Visibility="{Binding SelectedEntry.FileName, Converter={StaticResource NotNullToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" FontFamily="{StaticResource GlyphFont}"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedEntry.FileName}"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <!-- Action row -->
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Style="{StaticResource PrimaryButton}"
                                        Command="{Binding CopyCommand}"
                                        CommandParameter="{Binding SelectedEntry}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" FontFamily="{StaticResource GlyphFont}"
                                                   FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Copy to clipboard" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                                        Command="{Binding TogglePinCommand}"
                                        CommandParameter="{Binding SelectedEntry}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" FontFamily="{StaticResource GlyphFont}"
                                                   FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Pin" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedEntry.IsPinned}" Value="True">
                                                            <Setter Property="Text" Value="Unpin" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DestructiveButton}" Margin="10,0,0,0"
                                        Command="{Binding DeleteCommand}"
                                        CommandParameter="{Binding SelectedEntry}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" FontFamily="{StaticResource GlyphFont}"
                                                   FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Delete" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Image preview -->
                            <Border Margin="0,22,0,0" CornerRadius="14"
                                    Background="{StaticResource InsetSurfaceBrush}"
                                    Padding="16">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedEntry.Kind}" Value="{x:Static models:ClipboardContentKind.Image}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image Source="{Binding SelectedEntry.PayloadData, Converter={StaticResource PayloadToImage}}"
                                       MaxHeight="440" Stretch="Uniform" />
                            </Border>

                            <!-- Text content -->
                            <Border Margin="0,22,0,0" CornerRadius="14"
                                    Background="{StaticResource InsetSurfaceBrush}"
                                    Padding="20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" FontFamily="{StaticResource GlyphFont}"
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Content" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBox Text="{Binding SelectedEntry.TextContent, Mode=OneWay}"
                                             IsReadOnly="True"
                                             BorderThickness="0" Background="Transparent"
                                             FontFamily="{StaticResource MonoFont}"
                                             FontSize="12.5"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             MaxHeight="380"
                                             Margin="0,12,0,0"
                                             Padding="0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================== STATUS BAR ======================== -->
        <Border Grid.Row="2" Padding="24,10" BorderThickness="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontFamily="{StaticResource GlyphFont}"
                           Foreground="{StaticResource TextTertiaryBrush}" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{StaticResource TextTertiaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
