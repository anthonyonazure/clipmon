<Window x:Class="Clipmon.Views.TrayPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Clipmon.ViewModels"
        xmlns:models="clr-namespace:Clipmon.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Clipmon"
        Width="420"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Deactivated="OnDeactivated"
        FontFamily="{StaticResource UIFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Window.Resources>
        <!-- Dark popup palette (kept local so the main app's light theme is untouched) -->
        <Style TargetType="Border" x:Key="ColorSwatch">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <SolidColorBrush x:Key="PopupBg" Color="#1F1F22" />
        <SolidColorBrush x:Key="PopupBorder" Color="#3A3A3F" />
        <SolidColorBrush x:Key="PopupCard" Color="#2A2A2E" />
        <SolidColorBrush x:Key="PopupCardHover" Color="#33333A" />
        <SolidColorBrush x:Key="PopupButtonBg" Color="#2D2D32" />
        <SolidColorBrush x:Key="PopupButtonHover" Color="#3A3A40" />
        <SolidColorBrush x:Key="PopupInputBg" Color="#27272B" />
        <SolidColorBrush x:Key="PopupTextPrimary" Color="#F5F5F7" />
        <SolidColorBrush x:Key="PopupTextSecondary" Color="#A0A0A8" />
        <SolidColorBrush x:Key="PopupTextTertiary" Color="#6F6F78" />
        <SolidColorBrush x:Key="PopupDivider" Color="#34343A" />
        <SolidColorBrush x:Key="PopupAccent" Color="#5EE0A0" />
        <SolidColorBrush x:Key="PopupWarning" Color="#F2B441" />
        <SolidColorBrush x:Key="PopupDestructive" Color="#FF6B6B" />

        <!-- Bordered button (matches Mac .bordered button) -->
        <Style TargetType="Button" x:Key="PopupBorderedButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource PopupTextPrimary}" />
            <Setter Property="Background" Value="{StaticResource PopupButtonBg}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PopupButtonHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#454550" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tiny inline link-style button (Pin/Unpin in row, Quit in footer) -->
        <Style TargetType="Button" x:Key="PopupInlineButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource PopupTextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33333A" />
                                <Setter Property="Foreground" Value="{StaticResource PopupTextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search box -->
        <Style TargetType="TextBox" x:Key="PopupSearchBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="Foreground" Value="{StaticResource PopupTextPrimary}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{StaticResource PopupTextPrimary}" />
            <Setter Property="SelectionBrush" Value="#3A4FE6" />
        </Style>

        <!-- Clip row (selectable card with copy-on-click) -->
        <Style TargetType="ListBoxItem" x:Key="PopupClipRow">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{StaticResource PopupCard}"
                                CornerRadius="10"
                                Padding="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PopupCardHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ============== Outer shell: rounded dark card with shadow ============== -->
    <Border CornerRadius="14"
            Background="{StaticResource PopupBg}"
            BorderBrush="{StaticResource PopupBorder}"
            BorderThickness="1"
            Margin="14"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" Opacity="0.50"
                              ShadowDepth="6" Direction="270"
                              Color="#000000" />
        </Border.Effect>

        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ====== Header: title + live indicator ====== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE77F;"
                               FontFamily="{StaticResource GlyphFont}"
                               Foreground="{StaticResource PopupTextPrimary}"
                               FontSize="14"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Clipmon"
                               Foreground="{StaticResource PopupTextPrimary}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Live / paused indicator -->
                <TextBlock Grid.Column="2"
                           FontFamily="{StaticResource GlyphFont}"
                           FontSize="14"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE701;" />
                            <Setter Property="Foreground" Value="{StaticResource PopupAccent}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                    <Setter Property="Text" Value="&#xE769;" />
                                    <Setter Property="Foreground" Value="{StaticResource PopupTextTertiary}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- ====== Subtitle ====== -->
            <TextBlock Grid.Row="1"
                       Text="Clipboard history in the menu bar"
                       Foreground="{StaticResource PopupTextSecondary}"
                       FontSize="11"
                       Margin="0,4,0,0" />

            <!-- ====== Status line ====== -->
            <TextBlock Grid.Row="2"
                       Text="{Binding StatusMessage}"
                       Foreground="{StaticResource PopupTextTertiary}"
                       FontSize="11"
                       Margin="0,2,0,0"
                       TextTrimming="CharacterEllipsis" />

            <!-- ====== Search box ====== -->
            <Border Grid.Row="3"
                    Background="{StaticResource PopupInputBg}"
                    BorderBrush="{StaticResource PopupBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,6"
                    Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Search clipboard"
                               Foreground="{StaticResource PopupTextTertiary}"
                               FontSize="13"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource PopupSearchBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>

            <!-- ====== Action row 1: Open Window | Capture ====== -->
            <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource PopupBorderedButton}"
                        Click="OnOpenWindowClicked"
                        ToolTip="Open the full Clipmon window">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE78B;"
                                   FontFamily="{StaticResource GlyphFont}"
                                   FontSize="12"
                                   Margin="0,0,7,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Open Window" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource PopupBorderedButton}"
                        Command="{Binding CaptureNowCommand}"
                        ToolTip="Capture the current clipboard contents now">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;"
                                   FontFamily="{StaticResource GlyphFont}"
                                   FontSize="12"
                                   Margin="0,0,7,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Capture" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ====== Action row 2: Pause | Clear Unpinned ====== -->
            <Grid Grid.Row="5" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource PopupBorderedButton}"
                        Command="{Binding TogglePauseResumeCommand}"
                        ToolTip="Pause or resume clipboard monitoring">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource GlyphFont}"
                                   FontSize="12"
                                   Margin="0,0,7,0"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE769;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                            <Setter Property="Text" Value="&#xE768;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Pause" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                            <Setter Property="Text" Value="Resume" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource PopupBorderedButton}"
                        Command="{Binding ClearKeepingPinnedCommand}"
                        ToolTip="Clear unpinned clipboard items">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;"
                                   FontFamily="{StaticResource GlyphFont}"
                                   FontSize="12"
                                   Margin="0,0,7,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Clear Unpinned" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ====== Divider ====== -->
            <Border Grid.Row="6"
                    Height="1"
                    Background="{StaticResource PopupDivider}"
                    Margin="0,14,0,0"
                    VerticalAlignment="Top" />

            <!-- ====== Recent clips section ====== -->
            <StackPanel Grid.Row="6" Margin="0,22,0,0">
                <TextBlock Text="Recent Clips"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PopupTextPrimary}"
                           Margin="0,0,0,8" />

                <!-- Empty state -->
                <TextBlock FontSize="12"
                           Foreground="{StaticResource PopupTextTertiary}"
                           Margin="2,4,0,4"
                           Text="No clipboard items yet">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TotalCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ListBox x:Name="ClipsList"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ItemsSource="{Binding EntriesView}"
                         MaxHeight="380"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemContainerStyle="{StaticResource PopupClipRow}"
                         MouseDoubleClick="OnClipDoubleClick"
                         KeyDown="OnClipsListKeyDown"
                         PreviewMouseLeftButtonDown="OnClipsPreviewMouseDown"
                         PreviewMouseMove="OnClipsMouseMove">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ClipboardEntry}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top row: kind + title + pin glyph -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                    <Border Background="{Binding TextContent, Converter={StaticResource HexToBrush}}">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource ColorSwatch}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Color">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock FontFamily="{StaticResource GlyphFont}"
                                               Text="{Binding Kind, Converter={StaticResource KindToGlyph}}"
                                               Foreground="{StaticResource PopupTextSecondary}"
                                               FontSize="11"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Kind, Converter={StaticResource KindToDisplayName}}"
                                               Foreground="{StaticResource PopupTextSecondary}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               Foreground="{StaticResource PopupTextPrimary}"
                                               FontSize="12.5"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="240" />
                                </StackPanel>

                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           FontFamily="{StaticResource GlyphFont}"
                                           Text="{Binding IsPinned, Converter={StaticResource PinnedToGlyph}}"
                                           Foreground="{StaticResource PopupWarning}"
                                           FontSize="12"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />

                                <!-- Bottom row: time, filename, pin/unpin button -->
                                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding CreatedAt, Converter={StaticResource RelativeTime}}"
                                                   Foreground="{StaticResource PopupTextTertiary}"
                                                   FontSize="11" />
                                        <TextBlock Text="•"
                                                   Foreground="{StaticResource PopupTextTertiary}"
                                                   FontSize="11"
                                                   Margin="6,0"
                                                   Visibility="{Binding FileName, Converter={StaticResource NotNullToVisibility}}" />
                                        <TextBlock Text="{Binding FileName}"
                                                   Foreground="{StaticResource PopupTextTertiary}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="220"
                                                   Visibility="{Binding FileName, Converter={StaticResource NotNullToVisibility}}" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Click="OnPinToggleClicked">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PopupInlineButton}">
                                                <Setter Property="Content" Value="Pin" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                        <Setter Property="Content" Value="Unpin" />
                                                        <Setter Property="Foreground" Value="{StaticResource PopupWarning}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- ====== Footer divider ====== -->
            <Border Grid.Row="7"
                    Height="1"
                    Background="{StaticResource PopupDivider}"
                    Margin="0,12,0,0" />

            <!-- ====== Footer: status + Settings + Quit ====== -->
            <Grid Grid.Row="8" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource PopupTextTertiary}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SyncStatusText"
                               Foreground="{StaticResource PopupAccent}"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource PopupBorderedButton}"
                        Padding="10,5"
                        FontSize="11"
                        Margin="0,0,6,0"
                        Click="OnSettingsClicked"
                        ToolTip="Settings · sync, privacy">
                    <TextBlock Text="&#xE713;"
                               FontFamily="{StaticResource GlyphFont}"
                               FontSize="12" />
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource PopupBorderedButton}"
                        Padding="14,5"
                        FontSize="11"
                        Click="OnQuitClicked"
                        Content="Quit" />
            </Grid>
        </Grid>
    </Border>
</Window>
